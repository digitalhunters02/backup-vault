# ---- Storage (Backblaze B2 example; for AWS S3 leave S3_ENDPOINT empty and set S3_REGION) ----
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-key-id
S3_SECRET_ACCESS_KEY=your-application-key
S3_PREFIX=vault
# S3_FORCE_PATH_STYLE=true          # default: true when S3_ENDPOINT is set, false for AWS

# ---- Security (generate each one: openssl rand -hex 32) ----
# Header X-Backup-Key must carry this value on every API call (except GET /health). Min 16 chars.
BACKUP_API_KEY=
# Encrypts the connection URLs stored in the bucket (_vault/config.json). Min 16 chars. NEVER lose it.
BACKUP_CONFIG_KEY=
# OPTIONAL. If set, every new dump is encrypted (AES-256-GCM, .enc). NEVER lose it or those backups are unreadable.
BACKUP_ENCRYPTION_KEY=

# ---- Behaviour ----
TZ=America/Denver
PORT=4000
# Optional first-start seed (only used when the bucket has no config yet):
# BACKUP_TARGETS_JSON=[{"name":"rex","url":"postgres://user:pass@rex-db:5432/rex","schedule":{"type":"daily","time":"03:00"},"retention":{"daily":7,"weekly":4,"monthly":6}}]
# BACKUP_DUMP_TIMEOUT_MIN=120       # kill a pg_dump that runs longer than this
# BACKUP_TMP_DIR=/tmp               # where the dump file is written before upload (deleted afterwards)
# BACKUP_SCHEDULER=on               # "off" = API only, no automatic runs
